# AIRE Services Frontend Environment Variables
# Copy this to .env and fill in your values

# Clerk Authentication
# Get your key from: https://dashboard.clerk.com/last-active?path=api-keys
VITE_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Optional: custom Clerk JWT template that includes email/email_address claims.
# VITE_CLERK_JWT_TEMPLATE=aire-services

# API URL (Rails backend)
VITE_API_URL=http://localhost:3000

# Cornerstone Payroll web app (optional). Settings > Payroll connection links to its
# "Time tracking account" screen for reconnecting. Without it, that page explains the steps.
# On staging, VITE_STAGING_PAYROLL_FRONTEND_ORIGIN is used instead.
# VITE_CORNERSTONE_PAYROLL_URL=https://payroll.example.com

# PostHog Analytics (optional)
# Get your key from: https://us.posthog.com/settings/project#variables
VITE_PUBLIC_POSTHOG_KEY=YOUR_POSTHOG_KEY
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
