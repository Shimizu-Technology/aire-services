  "rules": [
    {
      "key": "own_role",
      "text": "Nobody can change their own role."
    },
    {
      "key": "last_owner",
      "text": "AIRE always keeps at least one active owner who signs in. The last one can't be given another role, terminated or lose sign-in."
    },
    {
      "key": "personal_sign_in",
      "text": "Owners, admins and managers always sign in personally. Only employees can be kiosk-only."
    },
    {
      "key": "break_glass",
      "text": "If no owner can sign in, Shimizu Technology can restore an owner with a recorded break-glass step."
    }
  ],
  "settings": [
    {
      "id": "managers_can_approve_own_time",
      "label": "Managers can approve their own time",
      "enabled": true,
      "effect": "Managers approve their own time.",
      "rows": [
        "approve_own_time"
      ],
      "change_in": "Settings → Time approvals",
      "path": "/admin/settings#time-approvals",
      "who": "Owners and admins"
    },
    {
      "id": "pay_stub_kiosk_requests_enabled",
      "label": "Pay stub requests at the kiosk",
      "enabled": false,
      "effect": "Workers can't ask for pay stubs at the kiosk.",
      "rows": [
        "get_own_stubs"
      ],
      "change_in": "Settings → Pay stubs",
      "path": "/admin/settings#pay-stubs",
      "who": "Owners and admins"
    },
    {
      "id": "pay_stub_self_email_enabled",
      "label": "Workers can email themselves stubs",
      "enabled": false,
      "effect": "Workers can't email themselves stubs; a sender does it from the Pay stubs page.",
      "rows": [
        "get_own_stubs"
      ],
      "change_in": "Settings → Pay stubs",
      "path": "/admin/settings#pay-stubs",
      "who": "Owners and admins"
    },
    {
      "id": "my_pay_enabled_for_all",
      "label": "My Pay for everyone",
      "enabled": false,
      "effect": "Only people with My Pay turned on individually can see it.",
      "rows": [
        "see_own_pay"
      ],
      "change_in": "Team → My Pay",
      "path": "/admin/users",
      "who": "Owners and admins",
      "individual_count": 0
    }
  ],
