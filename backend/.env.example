# AIRE Services Backend Environment Variables
# Copy this to .env and fill in your values

# ===========================================
# DATABASE
# ===========================================
# Development: Uses local PostgreSQL (no config needed)
# Production: Set DATABASE_URL to your Neon connection string
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/aire_services_db

# ===========================================
# AUTHENTICATION (Clerk)
# ===========================================
# Get your JWKS URL from: Clerk Dashboard > API Keys > Advanced > JWKS Public Key URL
# Format: https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# Optional but recommended: explicitly validate the token issuer.
# If omitted, the app derives the issuer from CLERK_JWKS_URL.
# CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Optional: validate one or more audiences (comma-separated) if your Clerk
# token template includes an aud claim for this API.
# CLERK_AUDIENCE=https://api.example.com
# Required for backend admin updates of Clerk-managed user profiles and
# for resolving email/password sign-ins when the Clerk JWT has no email claim.
# CLERK_SECRET_KEY=sk_test_xxxxx

# Bootstrap is invite-only by default. Set this temporarily only if you need
# to create the very first admin through Clerk on a fresh environment.
# ALLOW_FIRST_USER_BOOTSTRAP=false

# ===========================================
# FILE STORAGE (AWS S3)
# ===========================================
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=aire-services-guam

# ===========================================
# EMAIL (Resend)
# ===========================================
RESEND_API_KEY=re_your_api_key

# ===========================================
# GOOGLE MAPS / PLACES
# ===========================================
# Server-side key restricted to Places API / Places API (New).
# Used by the admin clock-in location picker.
# GOOGLE_MAPS_API_KEY=AIza...

# ===========================================
# SMS (ClickSend)
# ===========================================
CLICKSEND_USERNAME=your_username
CLICKSEND_API_KEY=your_api_key

# ===========================================
# FRONTEND (CORS)
# ===========================================
# Required in production/staging. Used to configure allowed CORS origins.
# FRONTEND_URL=https://your-frontend-domain.com

# ===========================================
# RAILS
# ===========================================
# Generate with: rails secret
SECRET_KEY_BASE=generate_with_rails_secret

# Active Record Encryption (for encrypting sensitive data like bank info)
# Generate with: bin/rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=your_32_char_primary_key_here
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=your_32_char_deterministic_key
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=your_32_char_salt_here

# Set only after the production Clerk instance enforces MFA and at least two
# recovery administrators have tested enrollment and account recovery. Bind
# the attestation to that exact instance and the retained release evidence.
REQUIRE_MFA=false
# CLERK_MFA_ATTESTED_INSTANCE_ID=ins_xxxxx
# CLERK_MFA_EVIDENCE_REF=security-evidence/aire-mfa-cutover-YYYY-MM-DD

# ===========================================
# PAYROLL INTEGRATION (CPR)
# ===========================================
# Shared secret for service-to-service payroll ingest API
PAYROLL_SHARED_SECRET=your_shared_secret_here
# HTTPS endpoint in Cornerstone that receives idempotent AIRE payroll events.
CORNERSTONE_PAYROLL_EVENTS_URL=https://payroll.example.com/api/v1/integrations/aire/events
# Report repeated finalization or delivery failures after this many attempts.
# PAYROLL_RETRY_ALERT_THRESHOLD=5
# PAYROLL_SETTLEMENT_RECONCILIATION_LOOKBACK_DAYS=62

# Production defaults to Solid Queue running inside Puma for this single-server
# deployment. Override these only when a dedicated job process is configured.
# ACTIVE_JOB_QUEUE_ADAPTER=solid_queue
# SOLID_QUEUE_IN_PUMA=true
